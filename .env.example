# Copie para .env e ajuste. Tudo é opcional.

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Endereço público (usado nas prévias do WhatsApp/Instagram e no sitemap).
# Ex.: https://role.seudominio.com.br
PUBLIC_URL=

# Onde o banco (arquivo JSON) fica salvo
DATA_FILE=./data/db.json

# Máximo de pessoas por sala
MAX_SALA=50

# SMS de verificação.
# Sem SMS_WEBHOOK_URL, o código aparece na tela (modo de teste).
# Com SMS_WEBHOOK_URL, o servidor faz POST {"to":"+55...","text":"..."} nessa URL
# (ex.: uma função sua que repassa para Twilio, Zenvia, etc.).
SMS_WEBHOOK_URL=
# SMS_DEV=1 mostra o código na tela mesmo com SMS configurado (não use em produção)
SMS_DEV=

# Pedidos de código de login por IP a cada 10 minutos (padrão 8; só mexa em testes)
# AUTH_LIMIT=8

# Origens aceitas no WebSocket, separadas por vírgula (vazio = qualquer)
ALLOWED_ORIGINS=

NODE_ENV=production

# Modo Supabase para o Cloudflare Pages (npm run build:pages). Sem estas duas, o Pages fica em modo local.
# A chave publishable é pública por desenho (quem protege é o RLS de supabase/schema.sql).
# Nunca ponha aqui a service_role nem a senha do banco.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Rolê FM (opcional): duração das músicas e recusa de lives. Veja docs/ROLE-FM.md
# YOUTUBE_API_KEY=
