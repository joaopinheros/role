# Copie para .env e ajuste. Tudo é opcional.

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Endereço público (usado nas prévias do WhatsApp/Instagram e no sitemap).
# Ex.: https://role.seudominio.com.br
PUBLIC_URL=

# Onde o banco (arquivo JSON) fica salvo
DATA_FILE=./data/db.json

# Máximo de pessoas por sala
MAX_SALA=50

# SMS de verificação.
# Sem SMS_WEBHOOK_URL, o código aparece na tela (modo de teste).
# Com SMS_WEBHOOK_URL, o servidor faz POST {"to":"+55...","text":"..."} nessa URL
# (ex.: uma função sua que repassa para Twilio, Zenvia, etc.).
SMS_WEBHOOK_URL=
# SMS_DEV=1 mostra o código na tela mesmo com SMS configurado (não use em produção)
SMS_DEV=

# Origens aceitas no WebSocket, separadas por vírgula (vazio = qualquer)
ALLOWED_ORIGINS=

NODE_ENV=production
